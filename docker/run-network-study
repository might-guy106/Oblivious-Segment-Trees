#!/bin/bash

# Network study runner for Docker containers
# Runs comprehensive network studies with varying latency/bandwidth
# For each network configuration, runs full batch experiments (all depths, modes)
#
# Usage: ./run-network-study [--latencies "5 10 20 30"] [--bandwidths "10 50 100"] [--depths "4 6 8"] [--variant segmenttree9]

set -e

# cd into the directory containing this script
if [[ $BASH_SOURCE = */* ]]; then
  cd -- "${BASH_SOURCE%/*}/" || exit
fi

# Default values (smaller subset for network studies)
LATENCIES="0 20 40 60 80 100"
BANDWIDTHS="10 50 100"
DEPTHS="4 6 8 12 16"
VARIANT="segmenttree11"
UPDATES="5"
QUERIES="5"

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --latencies)
            LATENCIES="$2"
            shift 2
            ;;
        --bandwidths)
            BANDWIDTHS="$2"
            shift 2
            ;;
        --depths)
            DEPTHS="$2"
            shift 2
            ;;
        --variant)
            VARIANT="$2"
            shift 2
            ;;
        --updates)
            UPDATES="$2"
            shift 2
            ;;
        --queries)
            QUERIES="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: $0 [options]"
            echo ""
            echo "Options:"
            echo "  --latencies \"5 10 20 30\"     Space-separated latencies in ms (default: \"5 10 20 30\")"
            echo "  --bandwidths \"10 50 100\"     Space-separated bandwidths in mbit (default: \"10 50 100\")"
            echo "  --depths \"4 6 8\"             Space-separated depths (default: \"4 6 8\")"
            echo "  --variant segmenttree9       Segment tree variant (default: segmenttree9)"
            echo "  --updates \"5\"                Number of updates (default: \"5\")"
            echo "  --queries \"5\"                Number of queries (default: \"5\")"
            echo ""
            echo "Example:"
            echo "  $0 --latencies \"5 10\" --bandwidths \"50 100\" --depths \"4 6 8\""
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Convert to arrays
read -ra LAT_ARRAY <<< "$LATENCIES"
read -ra BW_ARRAY <<< "$BANDWIDTHS"

TOTAL_CONFIGS=$((${#LAT_ARRAY[@]} * ${#BW_ARRAY[@]}))
CURRENT_CONFIG=0

echo "========================================="
echo "Docker Network Study Runner"
echo "========================================="
echo "Latencies: ${LAT_ARRAY[*]} ms"
echo "Bandwidths: ${BW_ARRAY[*]} mbit"
echo "Depths: $DEPTHS"
echo "Variant: $VARIANT"
echo "Total network configurations: $TOTAL_CONFIGS"
echo "========================================="
echo ""

# Clean existing logs before starting
echo "Cleaning existing logs in containers..."
./clean-logs

# Iterate through all network configurations
for lat in "${LAT_ARRAY[@]}"; do
    for bw in "${BW_ARRAY[@]}"; do
        CURRENT_CONFIG=$((CURRENT_CONFIG + 1))

        echo ""
        echo "========================================="
        echo "Network Configuration $CURRENT_CONFIG/$TOTAL_CONFIGS"
        echo "Latency: ${lat}ms, Bandwidth: ${bw}mbit"
        echo "========================================="

        # Set network parameters
        echo "Setting network parameters..."
        ./set-networking "${lat}ms" "${bw}mbit"

        # Run batch experiments for this network configuration
        echo "Running batch experiments with current network settings..."
        ./run-batch-experiments --depths "$DEPTHS" --updates "$UPDATES" --queries "$QUERIES" --variant "$VARIANT"

        # Tag all logs with network parameters
        echo "Tagging logs with network parameters..."
        lat_val=$(echo $lat | tr -d 'ms')
        bw_val=$(echo $bw | tr -d 'mbit')

        # Rename onlineonly, online csv files with network parameters
        docker exec -w /root/prac ${PRAC_DOCKER_PREFIX}prac_p0 bash -c "
            cd logs
            # Tag CSV files
            for f in performance_*.csv; do
                if [[ \"\$f\" != *\"_lat\"* ]]; then
                    base=\"\${f%.csv}\"
                    new_name=\"\${base}_lat${lat_val}ms_bw${bw_val}mbit.csv\"
                    mv \"\$f\" \"\$new_name\"
                    echo \"Renamed \$f -> \$new_name\"
                fi
            done

            # Tag execution log files
            for f in execution_*.log; do
                if [[ \"\$f\" != *\"_lat\"* ]]; then
                    base=\"\${f%.log}\"
                    new_name=\"\${base}_lat${lat_val}ms_bw${bw_val}mbit.log\"
                    mv \"\$f\" \"\$new_name\"
                    echo \"Renamed \$f -> \$new_name\"
                fi
            done
        "

        # Rename preprocessing csv files with network parameters
        docker exec -w /root/prac ${PRAC_DOCKER_PREFIX}prac_p2 bash -c "
            cd logs
            # Tag CSV files
            for f in performance_*.csv; do
                if [[ \"\$f\" != *\"_lat\"* ]]; then
                    base=\"\${f%.csv}\"
                    new_name=\"\${base}_lat${lat_val}ms_bw${bw_val}mbit.csv\"
                    mv \"\$f\" \"\$new_name\"
                    echo \"Renamed \$f -> \$new_name\"
                fi
            done

            # Tag execution log files
            for f in execution_*.log; do
                if [[ \"\$f\" != *\"_lat\"* ]]; then
                    base=\"\${f%.log}\"
                    new_name=\"\${base}_lat${lat_val}ms_bw${bw_val}mbit.log\"
                    mv \"\$f\" \"\$new_name\"
                    echo \"Renamed \$f -> \$new_name\"
                fi
            done
        "

        # Unset network parameters before next iteration
        echo "Unsetting network parameters..."
        ./unset-networking

        echo "Network configuration $CURRENT_CONFIG/$TOTAL_CONFIGS completed"
        sleep 2
    done
done

echo ""
echo "========================================="
echo "All Network Study Experiments Completed!"
echo "========================================="
echo "Total network configurations tested: $TOTAL_CONFIGS"
echo "Latencies: ${LAT_ARRAY[*]} ms"
echo "Bandwidths: ${BW_ARRAY[*]} mbit"
echo "Depths: $DEPTHS"
echo ""
echo "Logs are available in the container at: /root/prac/logs/"
echo ""
echo "To copy logs and plots to local machine, run:"
echo "  ./bring-plots"
echo ""
echo "To analyze network study results, run:"
echo "  cd .."
echo "  # First copy logs from container"
echo "  docker cp \${PRAC_DOCKER_PREFIX}prac_p0:/root/prac/logs/. logs/"
echo "  # Then run analysis"
echo "  python3 python_scripts/analyze_network_study.py"
echo "========================================="
